<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@android:color/transparent">

    <!-- Status -->
    <TextView
        android:id="@+id/notification_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Connected"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="10dp" />

    <!-- Download e Upload -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_down_blue"
            android:layout_marginEnd="6dp" />
        <TextView
            android:id="@+id/download_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-- kbps"
            android:textSize="13sp"
            android:textColor="@android:color/white" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_arrow_up_red"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="6dp" />
        <TextView
            android:id="@+id/upload_speed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="-- kbps"
            android:textSize="13sp"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Stop VPN -->
    <Button
        android:id="@+id/stop_vpn_button"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:text="Stop VPN"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/stop_button_background"
        android:layout_marginTop="10dp" />
</LinearLayout>
